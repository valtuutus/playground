@inject IJSRuntime JS

@if (_active)
{
    <div class="tour-backdrop" @onclick="SkipTour"></div>

    @if (_currentStep.TargetSelector is not null)
    {
        <div class="tour-spotlight" style="@SpotlightStyle()"></div>
    }

    <div class="tour-tooltip" style="@TooltipStyle()" @onclick:stopPropagation="true">
        <div class="tour-tooltip-header">
            <span class="tour-step-label">@(_step + 1) / @_steps.Length — @_currentStep.Title.ToUpper()</span>
            <button class="tour-skip-btn" @onclick="SkipTour">Skip tour</button>
        </div>
        <p class="tour-tooltip-body">@_currentStep.Body</p>
        <div class="tour-tooltip-footer">
            <button class="tour-back-btn" @onclick="PrevStep" disabled="@(_step == 0)">← Back</button>
            <div class="tour-dots">
                @for (int i = 0; i < _steps.Length; i++)
                {
                    <span class="tour-dot @(i == _step ? "active" : "")"></span>
                }
            </div>
            <button class="tour-next-btn" @onclick="NextStep">
                @(_step == _steps.Length - 1 ? "Done" : "Next →")
            </button>
        </div>
    </div>
}

@code {
    private record TourStep(string Title, string? TargetSelector, string Body);

    private static readonly TourStep[] _steps = new[]
    {
        new TourStep("Welcome to Valtuutus", null,
            "Valtuutus is a relationship-based access control library. This playground lets you model a permission schema, seed it with data, and run queries to see how access is resolved."),
        new TourStep("Schema Editor", ".b2-schema",
            "Write your authorization model here — entities, relations, and permissions. The entity graph on the right updates live as you type."),
        new TourStep("Entity Graph", ".b2-graph",
            "Your schema visualised as a live graph. Entities are nodes; relations and permissions appear as edges. Use it to verify your model structure at a glance."),
        new TourStep("Data Panel", ".b2-data",
            "Add relation tuples here — the runtime data that binds subjects to resources. For example: 'user:alice is admin of resource:api'."),
        new TourStep("Query Panel", ".b2-query",
            "Run Check queries to ask 'can subject X perform action Y on resource Z?' Results appear inline with a pass/fail badge."),
        new TourStep("Explain Mode", ".b2-graph",
            "Click Explain on any query to see exactly how the decision was reached — every permission node evaluated, with pass/fail highlighted on the resolution graph."),
    };

    private bool _active;
    private int _step;
    private ElementRect? _targetRect;

    private TourStep _currentStep => _steps[_step];

    private record ElementRect(double Top, double Left, double Width, double Height,
                               double ViewportWidth, double ViewportHeight);

    [Parameter] public EventCallback OnSetupRequested { get; set; }

    public async Task StartTourAsync()
    {
        _step = 0;
        await OnSetupRequested.InvokeAsync();
        _active = true;
        await RefreshRectAsync();
        StateHasChanged();
    }

    private async Task NextStep()
    {
        if (_step == _steps.Length - 1) { await FinishTour(); return; }
        _step++;
        await RefreshRectAsync();
    }

    private async Task PrevStep()
    {
        if (_step == 0) return;
        _step--;
        await RefreshRectAsync();
    }

    private async Task CloseTour()
    {
        await JS.InvokeVoidAsync("localStorage_set", "vtt-tour-seen", "1");
        _active = false;
        StateHasChanged();
    }

    private Task SkipTour() => CloseTour();

    private Task FinishTour() => CloseTour();

    private async Task RefreshRectAsync()
    {
        if (_currentStep.TargetSelector is null) { _targetRect = null; return; }
        _targetRect = await JS.InvokeAsync<ElementRect?>("getElementRect", _currentStep.TargetSelector);
    }

    private string SpotlightStyle()
    {
        if (_targetRect is null) return string.Empty;
        return $"top:{_targetRect.Top}px;left:{_targetRect.Left}px;" +
               $"width:{_targetRect.Width}px;height:{_targetRect.Height}px;";
    }

    private string TooltipStyle()
    {
        const double tooltipW = 320;
        const double tooltipH = 160;
        const double margin = 12;

        if (_targetRect is null)
            return $"top:50%;left:50%;transform:translate(-50%,-50%);width:{tooltipW}px;";

        double left = _targetRect.Left;
        double top  = _targetRect.Top + _targetRect.Height + margin;

        // Flip above if tooltip would overflow bottom
        if (top + tooltipH > _targetRect.ViewportHeight - 16)
            top = Math.Max(8, _targetRect.Top - tooltipH - margin);

        // Clamp right edge
        if (left + tooltipW > _targetRect.ViewportWidth - 16)
            left = _targetRect.ViewportWidth - tooltipW - 16;

        return $"top:{top}px;left:{left}px;width:{tooltipW}px;";
    }
}
