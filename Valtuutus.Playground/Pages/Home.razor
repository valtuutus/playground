@page "/"
@inject SchemaService SchemaService
@inject PersistenceService PersistenceService
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Valtuutus Playground</PageTitle>

<div class="app-shell">
    <header class="app-header">
        <div class="app-brand">
            <span class="brand-name">valtuutus</span>
            <span class="brand-sep">/</span>
            <span class="brand-sub">playground</span>
        </div>
        <div class="app-header-fill"></div>
        <a href="https://github.com/valtuutus/valtuutus" target="_blank" class="vtt-btn-ghost">GitHub</a>
        <button class="vtt-btn-ghost" @onclick="ToggleTheme">@(_isLightTheme ? "Dark" : "Light")</button>
        <button class="vtt-btn-ghost" @onclick="StartTourAsync">Tour</button>
        <button class="vtt-btn" @onclick="ShareAsync">Share</button>
    </header>

    <div class="app-layout-b2">
        <div class="b2-schema">
            <SchemaEditor @key="_isLightTheme"
                          @ref="_schemaEditor"
                          ActivePresetName="@_activePresetName"
                          OnSchemaChanged="OnSchemaChanged"
                          OnPresetLoaded="OnPresetLoaded"
                          OnEditorReady="OnEditorReady" />
        </div>
        <div class="b2-resize-handle"></div>
        <div class="b2-graph">
            <EntityGraph @ref="_graph" />
        </div>
        <div class="b2-data">
            <DataPanel @ref="_dataPanel"
                       Tuples="_tuples"
                       Attributes="_attributes"
                       OnDataChanged="OnDataChanged" />
        </div>
        <div class="b2-query">
            <QueryPanel @ref="_queryPanel"
                        Assertions="_assertions"
                        OnAssertionsChanged="OnAssertionsChanged"
                        OnExplainRequested="OnExplainRequested" />
        </div>
    </div>
</div>

@if (_showToast)
{
    <div class="vtt-toast">Link copied!</div>
}

<TourOverlay @ref="_tour" OnSetupRequested="SetupForTourAsync" />

@code {
    private string _schemaText = string.Empty;
    private string _activePresetName = string.Empty;
    private List<RelationTuple> _tuples = new();
    private List<AttributeTuple> _attributes = new();

    private List<Assertion> _assertions = new();
    private QueryPanel _queryPanel = default!;

    private EntityGraph _graph = default!;
    private TourOverlay _tour = default!;
    private DataPanel _dataPanel = default!;
    private SchemaEditor _schemaEditor = default!;

    // Tracks whether both sides are ready to sync:
    // _schemaText is set by async init, _editorMonacoReady by Monaco's OnEditorReady callback.
    private bool _editorMonacoReady;
    private bool _asyncInitDone;

    private bool _showToast;
    private bool _isLightTheme;

    protected override async Task OnInitializedAsync()
    {
        var saved = await PersistenceService.LoadAsync();
        var loadedFromSave = false;

        if (saved is not null && !string.IsNullOrWhiteSpace(saved.SchemaText))
        {
            var result = SchemaService.TrySetSchema(saved.SchemaText);
            if (result.IsValid)
            {
                _schemaText = saved.SchemaText;

                if (saved.Tuples?.Count > 0)
                    _tuples.AddRange(TupleParser.ParseLines(saved.Tuples));

                if (saved.Attributes?.Count > 0)
                    _attributes.AddRange(AttributeParser.ParseLines(saved.Attributes));

                if (saved.Assertions?.Count > 0)
                    _assertions.AddRange(AssertionParser.ParseLines(saved.Assertions));

                await SchemaService.ResetDataAsync(_tuples, _attributes);
                _activePresetName = PresetRegistry.All.FirstOrDefault(p => p.Schema == _schemaText)?.Name ?? string.Empty;
                loadedFromSave = true;
            }
        }

        if (!loadedFromSave)
            await LoadPreset(PresetRegistry.All[0]);

        _asyncInitDone = true;
        // If Monaco is already ready (fired before our async finished), push the schema now.
        if (_editorMonacoReady)
            await SyncSchemaToEditorAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await JS.InvokeVoidAsync("initSchemaResize");
        _graph.Refresh();
        var seen = await JS.InvokeAsync<string?>("localStorage_get", "vtt-tour-seen");
        if (seen is null)
            await _tour.StartTourAsync();
    }

    private async Task StartTourAsync()
    {
        try { await JS.InvokeVoidAsync("localStorage_remove", "vtt-tour-seen"); } catch { }
        await _tour.StartTourAsync();
    }

    private async Task SetupForTourAsync()
    {
        await LoadPreset(PresetRegistry.Rbac);
        await _schemaEditor.SetValueAsync(_schemaText);
        _graph.Refresh();
        _assertions = new List<Assertion>(PresetRegistry.Rbac.SeedAssertions ?? Array.Empty<Assertion>());
        await _dataPanel.LoadPresetData(PresetRegistry.Rbac.SeedTuples, PresetRegistry.Rbac.SeedAttributes);
        _activePresetName = PresetRegistry.Rbac.Name;
        StateHasChanged();

        if (!SchemaService.IsValid) return;
        var request = new CheckRequest(
            entityType: "resource", entityId: "api",
            permission: "read",
            subjectType: "user", subjectId: "alice");
        var explainResult = await SchemaService.ExplainAsync(request);
        var label = "user:alice · read · resource:api";
        _graph.ShowExplain(explainResult, label);
    }

    private async Task OnEditorReady()
    {
        _editorMonacoReady = true;
        // If async init already completed (stored _schemaText), push it into Monaco now.
        if (_asyncInitDone)
            await SyncSchemaToEditorAsync();
    }

    private async Task SyncSchemaToEditorAsync()
    {
        if (string.IsNullOrEmpty(_schemaText)) return;
        await _schemaEditor.SetValueAsync(_schemaText);
        _graph.Refresh();
    }

    private async Task OnSchemaChanged(string schema)
    {
        _schemaText = schema;
        _activePresetName = PresetRegistry.All.FirstOrDefault(p => p.Schema == schema)?.Name ?? string.Empty;
        if (SchemaService.IsValid)
        {
            await SchemaService.ResetDataAsync(_tuples, _attributes);
            _graph.Refresh();
        }
        _queryPanel?.ClearAssertionResults();
        await Persist();
    }

    private async Task OnPresetLoaded(PresetSchema preset)
    {
        _activePresetName = preset.Name;
        _schemaText = preset.Schema;
        _assertions = new List<Assertion>(preset.SeedAssertions ?? Array.Empty<Assertion>());
        await _dataPanel.LoadPresetData(preset.SeedTuples, preset.SeedAttributes);
        // _tuples and _attributes are updated in-place by LoadPresetData
        if (SchemaService.IsValid)
            await SchemaService.ResetDataAsync(_tuples, _attributes);
        _graph.Refresh();
        await Persist();
    }

    private async Task OnAssertionsChanged()
    {
        await Persist();
    }

    private void OnExplainRequested(ExplainRequestedArgs args)
    {
        _graph.ShowExplain(args.Result, args.Label);
    }

    private async Task OnDataChanged()
    {
        await SchemaService.ResetDataAsync(_tuples, _attributes);
        _queryPanel?.ClearAssertionResults();
        await Persist();
    }

    private PlaygroundState BuildCurrentState() =>
        new PlaygroundState
        {
            SchemaText = _schemaText,
            Tuples = _tuples.Select(TupleParser.ToShorthand).ToList(),
            Attributes = _attributes.Select(AttributeParser.ToShorthand).ToList(),
            Assertions = _assertions.Select(AssertionParser.ToShorthand).ToList(),
        };

    private async Task Persist()
    {
        await PersistenceService.SaveAsync(BuildCurrentState());
    }

    private async Task ToggleTheme()
    {
        _isLightTheme = !_isLightTheme;
        var cls = _isLightTheme ? "add" : "remove";
        await JS.InvokeVoidAsync("eval", $"document.documentElement.classList.{cls}('light')");
        await JS.InvokeVoidAsync("updateGraphTheme");
        await JS.InvokeVoidAsync("destroyEntityGraph");
        _graph.Refresh();
    }

    private async Task ShareAsync()
    {
        await PersistenceService.CopyShareUrlToClipboardAsync(BuildCurrentState());
        _showToast = true;
        StateHasChanged();
        await Task.Delay(2000);
        _showToast = false;
        StateHasChanged();
    }

    private async Task LoadPreset(PresetSchema preset)
    {
        _activePresetName = preset.Name;
        _schemaText = preset.Schema;
        _assertions = new List<Assertion>(preset.SeedAssertions ?? Array.Empty<Assertion>());
        SchemaService.TrySetSchema(_schemaText);

        _tuples.Clear();
        _attributes.Clear();

        if (!string.IsNullOrWhiteSpace(preset.SeedTuples))
            _tuples.AddRange(TupleParser.ParseLines(preset.SeedTuples.Split('\n')));

        if (!string.IsNullOrWhiteSpace(preset.SeedAttributes))
            _attributes.AddRange(AttributeParser.ParseLines(preset.SeedAttributes.Split('\n')));

        if (SchemaService.IsValid)
            await SchemaService.ResetDataAsync(_tuples, _attributes);
    }

    public void Dispose() { }
}
