@inherits LayoutComponentBase

<div class="playground-layout">
    <header class="playground-header">
        <span class="playground-title">Valtuutus Playground</span>
        <div style="display:flex;gap:8px;align-items:center">
            <button class="vtt-btn-outline" style="font-size:12px"
                    onclick="document.dispatchEvent(new CustomEvent('vtt-share'))">
                Share
            </button>
            <a href="https://github.com/valtuutus/valtuutus" target="_blank" class="playground-link">GitHub</a>
        </div>
    </header>
    <main class="playground-main">
        @Body
    </main>
</div>
